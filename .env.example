# Frontend
VITE_API_URL=http://localhost:4000/api/v1

# Docker Compose ports
WEB_PORT=8080
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
N8N_PORT=5678

# Local infrastructure
POSTGRES_DB=mediflow
POSTGRES_USER=mediflow
POSTGRES_PASSWORD=change-local-postgres-password
REDIS_PASSWORD=change-local-redis-password
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
N8N_WEBHOOK_SECRET=replace-with-an-independent-32-character-secret
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
TIMEZONE=Asia/Dhaka

# API security
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
CSRF_SECRET=replace-with-a-third-independent-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=
TRUST_PROXY=0
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
METRICS_TOKEN=replace-with-at-least-24-random-characters

# Automation providers
AUTOMATION_CONCURRENCY=10
AUTOMATION_MAX_ATTEMPTS=5
AUTOMATION_BACKOFF_MS=5000
AUTOMATION_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MediFlow AI <no-reply@mediflow.local>
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM=MediFlow

# AI is server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
AI_DEMO_MODE=true
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_INPUT_CHARS=20000
