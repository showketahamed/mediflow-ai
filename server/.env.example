NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mediflow:mediflow@localhost:5432/mediflow?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
CSRF_SECRET=replace-with-a-third-independent-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=
TRUST_PROXY=0
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_STORAGE=redis
METRICS_TOKEN=
DEMO_OTP=246810
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mediflow-redis
AUTOMATION_CONCURRENCY=10
AUTOMATION_MAX_ATTEMPTS=5
AUTOMATION_BACKOFF_MS=5000
AUTOMATION_DRY_RUN=true
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MediFlow AI <no-reply@mediflow.local>
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM=MediFlow
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
AI_DEMO_MODE=true
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_INPUT_CHARS=20000
