# Add these as Railway service variables. Reference a Railway Redis service
# using its generated REDISHOST, REDISPORT, and REDISPASSWORD values.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://prisma.PROJECT_REF:SUPABASE_DATABASE_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
REDIS_HOST=your-railway-redis-private-host
REDIS_PORT=6379
REDIS_PASSWORD=your-railway-redis-password
RATE_LIMIT_STORAGE=redis

JWT_ACCESS_SECRET=generate-at-least-32-random-characters
JWT_REFRESH_SECRET=generate-a-different-32-character-secret
CSRF_SECRET=generate-a-third-independent-32-character-secret
METRICS_TOKEN=generate-at-least-24-random-characters

CORS_ORIGIN=https://your-project.vercel.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=
TRUST_PROXY=1

AUTOMATION_DRY_RUN=true
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=generate-an-independent-n8n-signing-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
AI_DEMO_MODE=true
