NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://prisma.PROJECT_REF:SUPABASE_DATABASE_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

JWT_ACCESS_SECRET=generate-an-independent-random-value-of-at-least-32-characters
JWT_REFRESH_SECRET=generate-another-independent-random-value-of-at-least-32-characters
CSRF_SECRET=generate-a-third-independent-random-value-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGIN=https://app.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=.example.com
TRUST_PROXY=1

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_STORAGE=redis
METRICS_TOKEN=generate-a-random-monitoring-token-of-at-least-24-characters
REDIS_HOST=your-managed-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-managed-redis-password

AUTOMATION_CONCURRENCY=10
AUTOMATION_MAX_ATTEMPTS=5
AUTOMATION_BACKOFF_MS=5000
AUTOMATION_DRY_RUN=false
N8N_BASE_URL=https://n8n.example.com
N8N_WEBHOOK_SECRET=generate-an-independent-n8n-signing-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=MediFlow AI <no-reply@example.com>
SMS_API_URL=https://sms-provider.example.com/messages
SMS_API_TOKEN=your-sms-provider-token
SMS_FROM=MediFlow

OPENAI_API_KEY=your-server-side-openai-api-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
AI_DEMO_MODE=false
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_INPUT_CHARS=20000
